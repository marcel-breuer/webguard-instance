# Instance code (also sent as X-INSTANCE-CODE and used as location query).
WEBGUARD_LOCATION=
WEBGUARD_CORE_API_KEY=
WEBGUARD_CORE_API_URL=

QUEUE_DEFAULT_WORKERS=3
RUN_MAX_CONCURRENCY=3
# Enable only after WebGuard Core provides the monitoring job lease endpoints.
WEBGUARD_JOB_LEASES_ENABLED=false
# During Core rollout, additionally send results to the legacy result endpoints.
WEBGUARD_JOB_LEASES_DUAL_WRITE=false
# A stable worker identifier. It is deliberately separate from WEBGUARD_LOCATION.
WEBGUARD_INSTANCE_ID=
WEBGUARD_JOB_LEASE_MAX_BATCH=3
WEBGUARD_ALLOW_PRIVATE_TARGETS=false

PORT=8080
